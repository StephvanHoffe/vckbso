# Website Sporty (Apache, bijvoorbeeld een Managed VPS bij Vimexx). Zie docs/live-zetten-vimexx.md.
# Op Vercel (het voorbeeld) wordt dit bestand niet gebruikt; daar staat de doorverwijzing in vercel.json.

Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Altijd via een beveiligde verbinding (https)
  # (Geen X-Forwarded-Proto: die kop kan iedereen meesturen. Staat de site ooit achter een proxy of CDN,
  # stel dat dan daar in, en zet in Mijn BSO 'achter_proxy' => true in de config.)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www.domein.nl -> domein.nl (het adres zonder www is het hoofdadres, zoals in sitemap.xml)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Oude adressen uit de eerste versie van de site sturen we door naar de nieuwe pagina's,
# zodat links en zoekresultaten blijven werken.
<IfModule mod_alias.c>
  Redirect 301 /over-ons.html /alles-over-sporty.html
  Redirect 301 /diensten.html /een-middag-bij-sporty.html
  Redirect 301 /prijzen.html /abonnementen.html
  Redirect 301 /veelgestelde-vragen.html /contact.html#veelgestelde-vragen
  Redirect 301 /werken-bij.html /word-sporty-coach.html
</IfModule>

# Beveiligingskoppen voor de hele site (Mijn BSO zet er in beheer/ nog strengere bij)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Alleen na een geslaagde https-verbinding: de browser onthoudt een jaar lang dat de site https gebruikt
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

  # Content-Security-Policy voor de website (Mijn BSO in beheer/ stuurt zijn eigen, strengere beleid mee).
  # Alleen scripts van de site zelf, plus de twee kleine scripts in de pagina's (via hun vingerafdruk).
  # Pas je zo'n script aan, zet dan de nieuwe sha256 hier: npm test meldt welke (tests/csp.test.mjs).
  # formspree.io is de formulierendienst van het contactformulier (nog in te stellen, zie contact.html).
  <If "%{REQUEST_URI} !~ m#^/beheer/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KzGFexfVLN/ySbAPeJk3zsWkGLyjvn9+5XL739iDx6Q=' 'sha256-UDxZfYFDuMCHL0jf/obV6XX364umnZx7SE+es5Oq4TY='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io mailto:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  </If>
</IfModule>

# Kleiner versturen (sneller laden)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Bewaren in de browser. De bestandsnamen veranderen niet bij een nieuwe versie, dus css en js kort,
# foto's en letters langer. Pagina's altijd vers.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Verborgen bestanden (zoals .git of .user.ini) nooit tonen; de map voor certificaten wel
<IfModule mod_rewrite.c>
  RewriteRule (^|/)\.(?!well-known/) - [F]
</IfModule>
