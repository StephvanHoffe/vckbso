{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/over-ons.html", "destination": "/alles-over-sporty.html", "permanent": true },
    { "source": "/diensten.html", "destination": "/een-middag-bij-sporty.html", "permanent": true },
    { "source": "/prijzen.html", "destination": "/abonnementen.html", "permanent": true },
    { "source": "/veelgestelde-vragen.html", "destination": "/contact.html#veelgestelde-vragen", "permanent": true },
    { "source": "/werken-bij.html", "destination": "/word-sporty-coach.html", "permanent": true },
    { "source": "/beheer/inloggen.php", "destination": "/voorbeeld/beheer/inloggen.html", "permanent": false },
    { "source": "/beheer/aanmelden.php", "destination": "/voorbeeld/beheer/aanmelden.html", "permanent": false },
    { "source": "/beheer/wachtwoord-vergeten.php", "destination": "/voorbeeld/beheer/wachtwoord-vergeten.html", "permanent": false },
    { "source": "/beheer/privacy.php", "destination": "/voorbeeld/beheer/ouder-privacy.html", "permanent": false },
    { "source": "/beheer/proefdag.php", "destination": "/voorbeeld/beheer/proefdag-momenten.json", "permanent": false },
    { "source": "/beheer/", "destination": "/voorbeeld/", "permanent": false },
    { "source": "/beheer/:pad*", "destination": "/voorbeeld/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/voorbeeld/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
