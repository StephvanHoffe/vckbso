{
  "name": "sporty-website",
  "private": true,
  "description": "Statische website van Sporty. Geen build-stap nodig; de scripts hieronder zijn hulpmiddelen voor beeld, SEO en tests.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "seo": "node tools/structured-data.mjs",
